{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "actions-runner-tofu: runner base image, OpenTofu/Terragrunt/AWS CLI versions (Dockerfile ARGs), GitHub Actions, pre-commit hooks, CI tools.",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Europe/Berlin",
  "labels": [
    "dependencies"
  ],
  "prConcurrentLimit": 10,
  "prHourlyLimit": 0,
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security"
    ],
    "schedule": [
      "at any time"
    ]
  },
  "pre-commit": {
    "enabled": true
  },
  "pip_requirements": {
    "managerFilePatterns": [
      "/(^|/)requirements-ci\\.txt$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Tool versions in the Dockerfile: # renovate: datasource=<ds> depName=<name> [extractVersion=<regex>] on the line above an ARG",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+extractVersion=(?<extractVersion>\\S+))?\\s*\\nARG\\s+\\w+=(?<currentValue>\\S+)"
      ],
      "extractVersionTemplate": "{{#if extractVersion}}{{{extractVersion}}}{{else}}^(?<version>.*)${{/if}}"
    }
  ],
  "packageRules": [
    {
      "description": "Everything that ends up in the image → build(deps): semantic-release publishes a patch release",
      "matchFileNames": [
        "Dockerfile"
      ],
      "semanticCommitType": "build"
    },
    {
      "description": "Pipeline and tooling → ci(deps): no release",
      "matchManagers": [
        "github-actions",
        "pre-commit",
        "pip_requirements"
      ],
      "semanticCommitType": "ci"
    },
    {
      "description": "GitHub Actions and pre-commit hooks: one PR each",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions"
    },
    {
      "description": "OpenTofu and Terragrunt: same minor as on the workstations (OpenTofu 1.12, Terragrunt 1.1) and basement's version constraints – raise allowedVersions together with the workstation upgrade",
      "matchDepNames": [
        "opentofu/opentofu"
      ],
      "allowedVersions": "<1.13",
      "addLabels": [
        "workstation-first"
      ]
    },
    {
      "description": "Terragrunt: see OpenTofu",
      "matchDepNames": [
        "gruntwork-io/terragrunt"
      ],
      "allowedVersions": "<1.2",
      "addLabels": [
        "workstation-first"
      ]
    }
  ]
}
